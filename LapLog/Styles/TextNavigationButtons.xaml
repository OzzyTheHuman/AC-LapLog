<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TextNavigationButtons" TargetType="TextBlock">
        
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource NotActiveBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="30,0,0,0" />
        
        <!--TODO: smooth color changing button -->
        
        <Style.Triggers>
                
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                             Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                    
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                             Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
    </Style>
</ResourceDictionary>