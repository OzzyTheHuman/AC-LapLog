<UserControl x:Class="LapLog.Views.BestLapsLocalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LapLog.Views"
             xmlns:vms="clr-namespace:LapLog.ViewModels"
             mc:Ignorable="d" d:DesignHeight="*" d:DesignWidth="*"
             Style="{StaticResource Page_Style}">
    

    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            
        </Grid>
        
        <ComboBox Grid.Row="1"
                  Margin="0 7 0 0"
                  ItemsSource="{Binding AvailableTracks}" 
                  SelectedItem="{Binding SelectedTrack}"
                  Width="100"
                  HorizontalAlignment="Left" />
        
        <ComboBox Grid.Row="1"
                  Margin="110 7 0 0"
                  ItemsSource="{Binding AvailableCars}"
                  SelectedItem="{Binding SelectedCar}"
                  Width="100"
                  HorizontalAlignment="Left" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="220 10 0 0">
            <TextBlock Text="Sort by: " />
            <RadioButton Content="Lap Time" IsChecked="{Binding SortByTime}" GroupName="SortingGroup" Margin="5 2 0 0" />
            <RadioButton Content="Date" IsChecked="{Binding SortByDate}" GroupName="SortingGroup" Margin="5 2 0 0"/>
        </StackPanel>
        
        <ListView Grid.Row="2" Margin="0 7 0 0" ItemsSource="{Binding LapTimes}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Track" DisplayMemberBinding="{Binding TrackName}"/>
                    <GridViewColumn Header="Car" DisplayMemberBinding="{Binding CarName}"/>
                    <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}"/>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
